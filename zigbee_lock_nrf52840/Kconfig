# ==============================================================================
# MyHome Zigbee 门锁固件自定义配置项 (Kconfig)
# ==============================================================================
mainmenu "MyHome Zigbee Door Lock (Pro Micro nRF52840 + PC817)"

menu "MyHome Door Lock Hardware Settings"

config MYHOME_UNLOCK_PULSE_MS
	int "PC817 optocoupler unlock pulse duration (ms)"
	default 500
	range 100 3000
	help
	  Duration in milliseconds that the PC817 optocoupler stays active (HIGH)
	  to trigger the door lock button before automatically resetting to LOW.

config MYHOME_UNLOCK_COOLDOWN_MS
	int "Minimum cooldown interval between unlock triggers (ms)"
	default 3000
	range 500 30000
	help
	  Minimum cooldown period in milliseconds after an unlock pulse to prevent
	  duplicate Zigbee packet retries from re-triggering the door lock coil.

config MYHOME_ZED_SLEEP_POLL_MS
	int "Zigbee Sleepy End Device (ZED) parent poll interval (ms)"
	default 500
	range 100 5000
	help
	  How often the sleepy end device wakes up to poll its Zigbee parent for
	  pending unlock commands. 500ms balances sub-second unlock response and
	  ultra-low standby current.

endmenu

source "Kconfig.zephyr"
