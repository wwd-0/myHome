/*
 * ==============================================================================
 * Pro Micro nRF52840 (Nice!Nano v2) 设备树引脚覆盖文件 (nice_nano_v2.overlay)
 * 硬件接线说明：
 *   - P0.17 (丝印 017 / D2) -> 串联 1kΩ 限流电阻 -> PC817 第 1 脚 (阳极 +)
 *   - GND                   -> PC817 第 2 脚 (阴极 -)
 *   - PC817 第 4 脚 (集电极) -> 智能门锁室内开门按钮正极 (平时测得 ~3.3V 的触点)
 *   - PC817 第 3 脚 (发射极) -> 智能门锁室内开门按钮负极 (平时测得 0V / GND 的触点)
 *   - P0.20 (丝印 020 / D3) -> 配网按键 (短接 GND 3秒清除配网并重新入网)
 *   - P0.15                 -> 板载状态指示灯
 * ==============================================================================
 */

/ {
	chosen {
		zephyr,ieee802154 = &ieee802154;
	};

	leds {
		compatible = "gpio-leds";

		/* PC817 光耦驱动引脚：输出高电平驱动 PC817 导通门锁按钮 */
		pc817_optocoupler: pc817_pin {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "PC817 Door Unlock Optocoupler";
		};

		/* 板载状态指示 LED */
		status_led: led_status {
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
			label = "Onboard Status LED";
		};
	};

	buttons {
		compatible = "gpio-keys";

		/* 硬件配网引脚：P0.20 内部上拉，短接 GND 触发 */
		pair_button: button_pair {
			gpios = <&gpio0 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Zigbee Pairing Button";
		};
	};

	aliases {
		optocoupler0 = &pc817_optocoupler;
		statusled0 = &status_led;
		pairbtn0 = &pair_button;
	};
};

&ieee802154 {
	status = "okay";
};

/* 适配 UF2 Bootloader (保留 0xF4000 分区) */
/delete-node/ &code_partition;
/delete-node/ &storage_partition;

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		mbr_partition: partition@0 {
			label = "mbr";
			reg = <0x00000000 0x00001000>;
		};

		code_partition: partition@1000 {
			label = "image-0";
			reg = <0x00001000 0x000df000>;
		};

		zboss_nvram_partition: partition@e0000 {
			label = "zboss_nvram";
			reg = <0x000e0000 0x00008000>;
		};

		zboss_product_config_partition: partition@e8000 {
			label = "zboss_product_config";
			reg = <0x000e8000 0x00002000>;
		};

		storage_partition: partition@ea000 {
			label = "storage";
			reg = <0x000ea000 0x0000a000>;
		};

		boot_partition: partition@f4000 {
			label = "uf2_bootloader";
			reg = <0x000f4000 0x0000c000>;
			read-only;
		};
	};
};

